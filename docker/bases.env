# Basis-Images, auf denen die Servarr-Images gebaut werden: Versions-Tag UND Index-Digest, beide gepinnt.
# Stand 2026-11-08 (linux/amd64 und linux/arm64 aus demselben Index). Eine Änderung ist ein bewusstes Update:
# danach neu bauen und mit docker/build-smoke.sh prüfen.
# *_ALPINE_VERSION ist die Alpine-Minor-Version der jeweiligen Basis (cat /etc/alpine-release im Image);
# der ffmpeg-Builder nutzt dieselbe Version, damit die kopierten Bibliotheken zur Basis passen.
SONARR_BASE_IMAGE=lscr.io/linuxserver/sonarr:4.0.20.3014-ls4@sha256:673dc4609a5672bc8e46069c86ffcea283a86b48d34a6c93d8da8c24a1b87571
SONARR_ALPINE_VERSION=3.24
RADARR_BASE_IMAGE=lscr.io/linuxserver/radarr:6.4.4.10685-ls325@sha256:ade5937813c6ae415b29db729386e53fea3ecf067a019849bafbe2d2a6ec02ba
RADARR_ALPINE_VERSION=3.24
# Whisparr v3 ist ein hotio-Image (Alpine, gleiches /config- und PUID/PGID-Modell). Neueste v3-Release
# 3.6.5-release.1886; der bewegliche Tag v3 zeigt auf denselben Digest.
WHISPARR_BASE_IMAGE=ghcr.io/hotio/whisparr:v3-3.6.5-release.1886@sha256:5fca11d09ec746797701a286b7bd3a0f8b0d1d6710b619ac3a0e82a8854cca0e
WHISPARR_ALPINE_VERSION=3.23
